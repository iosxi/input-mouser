#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "resource.h"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
// ツールチェーン既定の manifest と同じ言語にして置き換えさせる
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "input-mouser.manifest"

LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT
IDI_APP    ICON "input-mouser.ico"
IDI_ACTIVE ICON "input-mouser-active.ico"

// ------------------------------------------------------------------
//  設定画面
// ------------------------------------------------------------------
IDD_MAIN DIALOGEX 0, 0, 420, 350
STYLE DS_SHELLFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "input-mouser"
FONT 9, "Yu Gothic UI", 400, 0, 0x80
BEGIN
    LTEXT           "画面の配置", IDC_H_LAYOUT, 12, 9, 200, 11
    LTEXT           "PC のタイルをドラッグして、実際に置いてある並びに合わせます。マウスを画面の端まで動かすと、その向きにある PC を操作できます。",
                    IDC_HINT_LAYOUT, 12, 22, 396, 18
    CONTROL         "", IDC_LAYOUT, "InputMouser.Layout", WS_TABSTOP, 12, 42, 330, 116
    PUSHBUTTON      "PC を追加(&A)...", IDC_ADD, 350, 42, 58, 15
    PUSHBUTTON      "編集(&E)...", IDC_EDITPEER, 350, 61, 58, 15
    PUSHBUTTON      "削除(&D)", IDC_DEL, 350, 80, 58, 15

    LTEXT           "このPC", IDC_H_THIS, 12, 170, 190, 11
    AUTOCHECKBOX    "ほかの PC からの操作を受け付ける(&R)", IDC_ACCEPT, 12, 184, 190, 10
    LTEXT           "ポート(&O)", IDC_PORT_LBL, 12, 200, 46, 9
    EDITTEXT        IDC_PORT, 60, 198, 40, 14, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "", IDC_THIS_INFO, 12, 216, 194, 18, SS_NOPREFIX
    LTEXT           "パスワード", IDC_PASS_LBL, 12, 240, 46, 9
    LTEXT           "", IDC_PASS_STATE, 60, 240, 84, 9, SS_NOPREFIX | SS_ENDELLIPSIS
    PUSHBUTTON      "変更(&W)...", IDC_PASS, 148, 237, 58, 15
    LTEXT           "全般", IDC_H_GENERAL, 12, 262, 190, 11
    AUTOCHECKBOX    "管理者として動かす(&M)", IDC_ADMIN, 12, 276, 194, 10
    LTEXT           "管理者のウィンドウ（タスク マネージャーなど）も操作できます。",
                    IDC_HINT_ADMIN, 24, 289, 182, 9

    LTEXT           "切り替え", IDC_H_SWITCH, 220, 170, 188, 11
    LTEXT           "端で押し続ける時間(&T)", -1, 220, 186, 86, 9
    EDITTEXT        IDC_DELAY, 308, 184, 32, 14, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "ミリ秒", -1, 344, 186, 40, 9
    LTEXT           "角の無効範囲(&C)", -1, 220, 204, 86, 9
    EDITTEXT        IDC_CORNER, 308, 202, 32, 14, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "ピクセル", -1, 344, 204, 40, 9
    AUTOCHECKBOX    "マウスのボタンを押している間は切り替えない(&B)", IDC_NODRAG, 220, 220, 188, 10
    AUTOCHECKBOX    "クリップボードを共有する（文字と画像）(&L)", IDC_CLIP, 220, 234, 188, 10
    LTEXT           "このPC に戻る(&H)", -1, 220, 252, 86, 9
    EDITTEXT        IDC_HK_HOME, 308, 250, 100, 14, ES_AUTOHSCROLL
    LTEXT           "切り替えを固定(&K)", -1, 220, 270, 86, 9
    EDITTEXT        IDC_HK_LOCK, 308, 268, 100, 14, ES_AUTOHSCROLL
    LTEXT           "欄を選んでキーを押すと登録されます。Delete で消せます。",
                    IDC_HINT_SWITCH, 220, 286, 188, 18

    LTEXT           "", IDC_INIPATH, 12, 310, 396, 9, SS_PATHELLIPSIS | SS_NOPREFIX
    PUSHBUTTON      "閉じる", IDCANCEL, 350, 328, 58, 15
END

// ------------------------------------------------------------------
//  相手の PC
// ------------------------------------------------------------------
IDD_PEER DIALOGEX 0, 0, 260, 228
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "操作する PC"
FONT 9, "Yu Gothic UI", 400, 0, 0x80
BEGIN
    LTEXT           "接続先", IDC_H_PEER, 12, 9, 200, 11
    LTEXT           "PC の名前または IP アドレス(&N)", -1, 12, 25, 180, 9
    EDITTEXT        IDC_HOST, 12, 36, 180, 14, ES_AUTOHSCROLL
    LTEXT           "ポート(&P)", -1, 200, 25, 48, 9
    EDITTEXT        IDC_PPORT, 200, 36, 48, 14, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "同じネットワークで見つかった PC", IDC_H_FOUND, 12, 58, 236, 11
    CONTROL         "", IDC_FOUND, "SysListView32",
                    LVS_REPORT | LVS_SHOWSELALWAYS | LVS_SINGLESEL | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP,
                    12, 72, 236, 72
    PUSHBUTTON      "もう一度探す(&F)", IDC_FIND, 12, 148, 70, 15
    LTEXT           "", IDC_FIND_STATE, 88, 151, 160, 9, SS_NOPREFIX
    LTEXT           "ホットキー(&K)", -1, 12, 172, 60, 9
    EDITTEXT        IDC_PHK, 74, 170, 100, 14, ES_AUTOHSCROLL
    LTEXT           "押すと、この PC へ直接切り替えます。", IDC_HINT_PHK, 74, 187, 174, 9
    DEFPUSHBUTTON   "OK", IDOK, 136, 206, 54, 15
    PUSHBUTTON      "キャンセル", IDCANCEL, 194, 206, 54, 15
END

// ------------------------------------------------------------------
//  パスワード
// ------------------------------------------------------------------
IDD_PASSWORD DIALOGEX 0, 0, 260, 122
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "パスワード"
FONT 9, "Yu Gothic UI", 400, 0, 0x80
BEGIN
    LTEXT           "つなぐ PC すべてに同じパスワードを設定します。通信はこのパスワードから作った鍵で暗号化されます。パスワードそのものは保存しません。",
                    IDC_PW_HINT, 12, 9, 236, 27
    LTEXT           "パスワード(&P)", -1, 12, 44, 56, 9
    EDITTEXT        IDC_PW1, 70, 42, 178, 14, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT           "もう一度(&A)", -1, 12, 62, 56, 9
    EDITTEXT        IDC_PW2, 70, 60, 178, 14, ES_PASSWORD | ES_AUTOHSCROLL
    AUTOCHECKBOX    "文字を表示する(&S)", IDC_PW_SHOW, 70, 78, 120, 10
    DEFPUSHBUTTON   "OK", IDOK, 136, 100, 54, 15
    PUSHBUTTON      "キャンセル", IDCANCEL, 194, 100, 54, 15
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041104b0"
        BEGIN
            VALUE "CompanyName", "nekoryu"
            VALUE "FileDescription", "input-mouser - 1 組のキーボードとマウスで複数の PC を操作"
            VALUE "FileVersion", "1.1.0"
            VALUE "ProductName", "input-mouser"
            VALUE "ProductVersion", "1.1.0"
            VALUE "Comments", "画面の端を越えると、LAN でつながった隣の PC を操作できます"
            VALUE "OriginalFilename", "input-mouser.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0411, 1200
    END
END
